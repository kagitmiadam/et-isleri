<header class="header-field w-full left-0 top-0 !hidden fixed z-[100] duration-300 h-[--header-height] [&.scrolling-down]:-translate-y-full" data-detect-scroll-direction="reset-at-top" data-detect-scroll-offset="60">
   <div class="container range-container [--minv-container:1260] [--maxv-container:1800] max-w-[--range-container] px-[--gap] w-full mx-auto">
      <div class="wrapper">
      </div>
   </div>
</header>

<penta-yazilim class="block">

<main class="main-field relative">
   <section class="hero-section h-[100vh] lg:h-full  w-full relative min-lg:overflow-hidden">
      <div class="flex justify-center items-center h-full w-full xsm:p-[20px] lg:p-[60px]">

         <div id="video-animation" class="absolute inset-0 z-[-1] left-0 h-full w-full" style="padding: 10px;">
            <video autoplay="" loop="" muted="" playsinline="" class="h-full w-full object-cover">
               <source type="video/mp4" src="promotion.mp4" class="full-cover">
            </video>
         </div>
         <div id="applyForm"
            class="max-w-[1017px] mx-auto bg-white z-100 p-[38px_70px] lg:p-[30px_40px] xsm:p-[20px_20px]">


            <h2 class="title text-[32px] sm:text-[25px]  text-[#1E1E1E] leading-[48px]  font-[500] text-center">
               ÖN KAYIT FORMU</h2>

            <div class="form-field pt-[38px] sm:pt-[20px]">
               <form action="index.html" method="post" class="" aria-label="İletişim Formu" enctype="multipart/form-data"
                  novalidate="novalidate" data-status="init">

                  <div class="form-container grid grid-cols-1 gap-[38px] xl:gap-7">
                     <div class="form-item">
                        <div class="inner-form grid grid-cols-2 gap-[31px] sm:grid-cols-2 sm:gap-4 xsm:grid-cols-1">
                           <div class="item group/item relative flex items-center justify-between bg-[#F8F8F8]">
                              <span class="w-full" data-name="your-name"><input
                                    class="font-[500] leading-normal bg-[#F8F8F8] w-full h-[70px] xs:h-[50px] text-[#1E1E1E] placeholder:text-[#1E1E1E]/70 text-[16px] xs:text-[14px] py-[25px] px-[30px] sm:px-7"
                                    aria-required="true" aria-invalid="false" placeholder="Adınız Soyadınız*" value=""
                                    type="text" name="your-name"></span>
                           </div>

                           <div class="item group/item relative flex items-center justify-between">
                              <span class="w-full" data-name="your-phone"><input size="50"
                                    class="font-[500] leading-normal bg-[#F8F8F8] w-full h-[70px] xs:h-[50px] text-[#1E1E1E] placeholder:text-[#1E1E1E]/70 text-[16px] xs:text-[14px] py-[25px] px-[30px] sm:px-7"
                                    aria-required="true" aria-invalid="false" placeholder="Telefon Numaranız*" value=""
                                    type="tel" name="your-phone"></span>
                           </div>
                           <div class="item group/item relative flex items-center justify-between">
                              <span class="w-full" data-name="your-date"><input
                                    class="font-[500] leading-normal bg-[#F8F8F8] w-full h-[70px] xs:h-[50px] text-[#1E1E1E] placeholder:text-[#1E1E1E]/70 text-[16px] xs:text-[14px] py-[25px] px-[30px] sm:px-7"
                                    aria-required="true" aria-invalid="false" placeholder="Doğum Tarihi GG/AA/YY"
                                    value="" type="text" name="your-date"></span>
                           </div>
                           <div class="item group/item relative flex items-center justify-between">
                              <span class="w-full" data-name="your-email"><input
                                    class="font-[500] leading-normal bg-[#F8F8F8] w-full h-[70px] xs:h-[50px] text-[#1E1E1E] placeholder:text-[#1E1E1E]/70 text-[16px] xs:text-[14px] py-[25px] px-[30px] sm:px-7"
                                    aria-required="true" aria-invalid="false" placeholder="E-posta Adresiniz*" value=""
                                    type="email" name="your-email"></span>
                           </div>
                        </div>
                     </div>
                     <div class="form-item">
                        <div class="inner-form flex flex-col gap-[15px] sm:grid-cols-2 sm:gap-4 xsm:grid-cols-1">
                           <div class="w-full">
                              <div
                                 class="item group/item relative flex items-center justify-between col-span-1 xl:mb-0">
                                 <span class="w-full " data-name="your-language">
                                    <textarea cols="100" rows="2" resize="none" maxlength="2000"
                                       class="font-[500] min-h-[150px] resize-none leading-normal resizw bg-[#F8F8F8] w-full h-[70px] xs:h-[50px] text-[#1E1E1E] placeholder:text-[#1E1E1E]/70 text-[16px] xs:text-[14px] py-[25px] px-[30px] sm:px-7"
                                       aria-invalid="false"
                                       placeholder="Payex’te, fiziki kart ve fiziksel cüzdan taşıma ihtiyacının ortandan kalkması dışında başka bir beklentiniz var mı? Varsa, nelerdir?"
                                       name="your-language"></textarea>
                                 </span>
                              </div>

                           </div>
                           <div class="flex flex-col gap-[30px] sm:grid-cols-2 sm:gap-4 xsm:grid-cols-1">
                              <div class="w-full grid grid-cols-2 gap-[30px] md:gap-[20px] sm:gap-4 xsm:grid-cols-1">
                                 <div
                                    class="item group/item relative flex items-center justify-between col-span-1 xl:mb-0">
                                    <div class="form-el group/form flex items-start min-md:items-center gap-[10px] relative">
                                       <div id="checkboxWrapper"
                                          class="company mt-[6px] relative shrink-0 h-[10px] w-[10px] bg-[#E0EFF2] duration-300">
                                          <input type="checkbox" name="company"
                                             class="peer w-[10px] companyBox h-[10px] bg-[#E0EFF2] cursor-pointer checked:!bg-[#1E1E1E] absolute z-10 left-0 top-0 duration-300"
                                           >
                                          <div
                                             class="peer relative shrink-0 h-[10px] w-[10px] bg-[#E0EFF2] z-1 peer-checked:!bg-[#1E1E1E] duration-300">
                                          </div>
                                       </div>


                                       <label for="company" class="text-[#1E1E1E]/60 leading-snug duration-350 ">
                                          İşyeri adına kayıt oluşturmak istiyorum</label>
                                    </div>

                                 </div>
                                 <div
                                    class="item group/item relative flex items-center justify-between col-span-1 xl:mb-0">
                                    <div class="form-el group/form flex items-start min-md:items-center gap-[10px] relative">
                                       <div id="checkboxWrapper"
                                          class="checkboxWrapper user mt-[6px] relative shrink-0 h-[10px] w-[10px] bg-[#E0EFF2] duration-300">
                                          <input type="checkbox" name="user" 
                                             class="peer w-[10px] userBox h-[10px] bg-[#E0EFF2] cursor-pointer checked:!bg-[#1E1E1E] absolute z-10 left-0 top-0 duration-300"
                                            >
                                          <div
                                             class="peer relative shrink-0 h-[10px] w-[10px] bg-[#E0EFF2] z-1 peer-checked:!bg-[#1E1E1E] duration-300">
                                          </div>
                                       </div>


                                       <label for="user" class="text-[#1E1E1E]/60 leading-snug duration-350 ">
                                          Kendi adıma kayıt oluşturmak istiyorum.</label>

                                    </div>
                                 </div>

                              </div>
                              <div
                                 class="flex justify-between items-end gap-[30px] w-full col-span-4 xsm:gap-[15px] xsm:flex-col xs:gap-[20px]">
                                 <div class="kvkk-field group/item relative ">
                                    <div
                                       class="relative w-fit h-full flex items-start flex-col justify-center gap-[16px]">
                                       <div class="form-el group/form flex justify-start  gap-[15px] relative">
                                          <div id="checkboxWrapper"
                                             class="checkboxWrapper mt-[6px] relative shrink-0 h-[10px] w-[10px] bg-[#E0EFF2] duration-300">
                                             <input type="checkbox" name="kvkk" 
                                                class="peer w-[10px]  h-[10px] bg-[#E0EFF2] cursor-pointer checked:!bg-[#1E1E1E] absolute z-10 left-0 top-0 duration-300"
                                                id="gdpr">
                                             <div
                                                class="peer relative shrink-0 h-[10px] w-[10px] bg-[#E0EFF2] z-1 peer-checked:!bg-[#1E1E1E] duration-300">
                                             </div>
                                          </div>


                                          <label id="open-popup" for="kvkk"
                                             class="text-[#1E1E1E]/60 leading-snug duration-350 "><span id="open-popup"
                                                class="inline relative z-20 cursor-pointer text-[#1E1E1E] font-semibold duration-350">Aydınlatma
                                                Metni</span>’ni Okudum ve
                                             Kabul
                                             Ediyorum.</label>
                                       </div>

                                       <div class="form-el group/form flex items-start relative">

                                          <div class="text-[#1E1E1E]/60 leading-snug duration-350  max-w-[500px]">
                                             payeX’e
                                             katılın, lansmanımıza özel fırsatlardan haberdar olun!
                                             İlk üç ay ücretsiz payeX+ deneme fırsatı için hemen kaydolun.
                                          </div>
                                       </div>
                                    </div>
                                 </div>
                                 <div
                                    class="button-field group/item relative col-span-1 xs:w-full min-w-[130px] xsm:w-full">

                                    <button type="submit"
                                       class="button group/button w-full bg-[#1E1E1E] text-[20px] min-lg:hover:bg-black/85 duration-500 text-white font-medium leading-[30px] flex justify-center xsm:p-[10px_15px] xsm:text-[18px] items-center p-[15px_30px]">
                                       Kayıt ol
                                    </button>
                                 </div>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
               </form>
            </div>
         </div>
      </div>

      <div
         class="logo-payet min-xsm:absolute w-fit min-xsm:left-1/2 min-xsm:-translate-x-1/2 min-xsm:bottom-4 sm:bottom-3 min-xsm:translate-y-[20px] opacity-0 xsm:opacity-100   xsm:pt-[10px]  xsm:pb-[10px] xsm:relative xsm:flex xsm:w-full xsm:justify-center xsm:items-center xsm:translate-x-0 xsm:translate-y-0">
         <a href="https://payex.tr/">
