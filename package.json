{
  "name": "landing-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind tabanlı tek sayfa landing boilerplate",
  "scripts": {
    "dev": "npm-run-all --parallel watch:css serve",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./assets/css/style.css --watch",
    "serve": "serve . -l 3000",
    "build": "tailwindcss -i ./src/css/input.css -o ./assets/css/style.css --minify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set-domain": "node scripts/set-domain.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.6.11",
    "serve": "^14.2.4",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "3.4.17"
  }
}
